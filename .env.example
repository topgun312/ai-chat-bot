# .env — НЕ коммитить в git!

# ── Провайдер: ollama | openai | anthropic ───────────────────────
PROVIDER=ollama

# ollama — локальные модели (по умолчанию, ключ не нужен)
MODEL=llama3.2
# OLLAMA_BASE_URL=http://localhost:11434

# openai — нужен, если PROVIDER=openai
# OPENAI_API_KEY=sk-...
# MODEL=gpt-4o

# anthropic — нужен, если PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-api03-...
# MODEL=claude-sonnet-4-6

# Опционально — переопределяет дефолты
TEMPERATURE=0.9
MAX_TOKENS=1500
BOT_NAME=Макс
